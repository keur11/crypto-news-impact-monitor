    "archive": "data/confirmed-archive.json",
    "calibration": "data/calibration.json",
    "marketState": "data/market-state.json",
    "stories": "data/stories.json",
    "bundle": "data/bundle.js",
    "keepalive": "data/keepalive.json"
  },
  "http": {
    "timeoutMs": 20000,
    "maxAttempts": 3,
    "backoffBaseMs": 1000,
    "backoffMaxMs": 15000,
    "retryOn": [
      429,
      500,
      502,
      503,
      504
    ]
  },
  "cache": {
    "dir": "cache/prices",
    "immutableAfterMs": 86400000
  },
  "providers": {
    "binanceApi": {
      "baseUrl": "https://data-api.binance.vision",
      "klinesPath": "/api/v3/klines",
      "maxLimit": 1000,
      "minIntervalMs": 250
    },
    "binanceArchive": {
      "baseUrl": "https://data.binance.vision",
      "pathTemplate": "/data/spot/monthly/klines/{symbol}/{interval}/{symbol}-{interval}-{yyyy}-{mm}.zip",
      "verifyChecksum": true,
      "minIntervalMs": 250
    },
    "bitstamp": {
      "baseUrl": "https://www.bitstamp.net",
      "ohlcPath": "/api/v2/ohlc/{pair}/",
      "maxLimit": 1000,
      "minIntervalMs": 500
    },
    "coingecko": {
      "baseUrl": "https://api.coingecko.com/api/v3",
      "apiKeyEnv": "COINGECKO_DEMO_API_KEY",
      "apiKeyHeader": "x-cg-demo-api-key",
      "minIntervalMs": 2500,
      "refreshHours": 24
    },
    "rss": {
      "minIntervalMs": 0
    }
  },
