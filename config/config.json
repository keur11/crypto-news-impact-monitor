{
  "app": {
    "name": "Crypto News Impact Monitor",
    "version": "0.6.0",
    "userAgent": "CryptoNewsImpactMonitor/0.6 (news impact analytics; no trading)",
    "contactEnv": "CONTACT_EMAIL",
    "secretEnvs": [
      "CONTACT_EMAIL",
      "COINGECKO_DEMO_API_KEY"
    ]
  },
  "paths": {
    "libraryInput": "config/library.json",
    "libraryOutput": "data/library.json",
    "seriesDir": "data/series",
    "backfillLog": "data/backfill-log.json",
    "articles": "data/articles.json",
    "events": "data/events.json",
    "sectors": "data/sectors.json",
    "status": "data/status.json",
